# Allowlist: everything in ~/.claude is private by default.
# Only the portable configuration below is tracked.
*
!.gitignore
!.gitmodules
!.gitattributes
!README.md
!wsl-link.sh
!CLAUDE.md
!settings.json
!agents/
!agents/**
!ecc-library

# Skills: every installed skill is portable, so the folder is tracked whole,
# except what Claude Code manages itself and syncs per account.
!skills/
!skills/**
skills/synced/

# Never, even inside the allowed folders.
**/__pycache__/
**/*.local.json
**/.provenance.json
